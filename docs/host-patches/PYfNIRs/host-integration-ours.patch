+"""Source-aware PYfNIRs plugin detection and menu integration tests."""
+from __future__ import annotations
+
+import json
+import os
+from pathlib import Path
+import tempfile
+import unittest
+from unittest.mock import patch
+
+os.environ.setdefault("QT_QPA_PLATFORM", "offscreen")
+
+from pyml_workbench.gui import WorkbenchWindow
+from pyml_workbench.plugin_dialog import (
+    PluginSettingsDialog,
+    PyfNIRsPluginSettingsDialog,
+)
+from pyml_workbench.plugins import (
+    PluginError,
+    PluginSettings,
+    PluginSettingsStore,
+    detect_data_conversion,
+    detect_pyfnirs_data_conversion,
+)
+from PySide6.QtWidgets import QApplication
+
+
+def _write_plugin(
+    directory: Path,
+    *,
+    source_project: str | None = None,
+    include_source: bool = True,
+    entry_path: str = "PYfNIRs-DataConversion.exe",
+    create_entry: bool = True,
+) -> Path:
+    directory.mkdir(parents=True, exist_ok=True)
+    entry = directory / entry_path
+    if create_entry:
+        entry.parent.mkdir(parents=True, exist_ok=True)
+        entry.write_bytes(b"synthetic placeholder; detector must not execute it")
+    manifest = {
+        "schema_version": 1,
+        "id": "data-conversion",
+        "name": "Synthetic converter",
+        "version": "0.0-test",
+        "entrypoint": {"kind": "executable", "path": entry_path},
+    }
+    if include_source:
+        manifest["source_project"] = source_project
+    (directory / "pyml-plugin.json").write_text(
+        json.dumps(manifest, ensure_ascii=False), encoding="utf-8"
+    )
+    return entry
+
+
+class PluginDetectionTest(unittest.TestCase):
+    def setUp(self) -> None:
+        self.temporary = tempfile.TemporaryDirectory(prefix="pyfnirs-plugin-detect-")
+        self.root = Path(self.temporary.name)
+
+    def tearDown(self) -> None:
+        self.temporary.cleanup()
+
+    def test_dedicated_detector_requires_exact_source_and_existing_in_tree_entry(self) -> None:
+        legacy = self.root / "legacy"
+        _write_plugin(legacy, include_source=False)
+        with self.assertRaises(PluginError):
+            detect_pyfnirs_data_conversion(PluginSettings(str(legacy)))
+
+        wrong_source = self.root / "wrong-source"
+        _write_plugin(wrong_source, source_project="HyperEEG")
+        with self.assertRaises(PluginError):
+            detect_pyfnirs_data_conversion(PluginSettings(str(wrong_source)))
+
+        wrong_case = self.root / "wrong-case"
+        _write_plugin(wrong_case, source_project="pyfnirs")
+        with self.assertRaises(PluginError):
+            detect_pyfnirs_data_conversion(PluginSettings(str(wrong_case)))
+
+        missing_entry = self.root / "missing-entry"
+        _write_plugin(missing_entry, source_project="PYfNIRs", create_entry=False)
+        with self.assertRaises(PluginError):
+            detect_pyfnirs_data_conversion(PluginSettings(str(missing_entry)))
+
+        outside = self.root / "outside.exe"
+        outside.write_bytes(b"synthetic")
+        escaped_entry = self.root / "escaped-entry"
+        _write_plugin(
+            escaped_entry,
+            source_project="PYfNIRs",
+            entry_path="../outside.exe",
+            create_entry=False,
+        )
+        with self.assertRaises(PluginError):
+            detect_pyfnirs_data_conversion(PluginSettings(str(escaped_entry)))
+
+        valid = self.root / "valid"
+        valid_entry = _write_plugin(valid, source_project="PYfNIRs")
+        detected = detect_pyfnirs_data_conversion(PluginSettings(str(valid)))
+        self.assertEqual(Path(detected.program), valid_entry.resolve())
+        self.assertEqual(detected.arguments, ())
+
+    def test_generic_detector_keeps_accepting_legacy_hypereeg_manifest(self) -> None:
+        legacy = self.root / "legacy"
+        legacy_entry = _write_plugin(legacy, include_source=False)
+
+        detected = detect_data_conversion(PluginSettings(str(legacy)))
+
+        self.assertEqual(Path(detected.program), legacy_entry.resolve())
+        self.assertEqual(detected.arguments, ())
+
+
+class PluginMenuIntegrationTest(unittest.TestCase):
+    @classmethod
+    def setUpClass(cls) -> None:
+        cls.application = QApplication.instance() or QApplication(["pyfnirs-plugin-integration"])
+
+    def setUp(self) -> None:
+        self.temporary = tempfile.TemporaryDirectory(prefix="pyfnirs-plugin-menu-")
+        self.root = Path(self.temporary.name)
+        self.preferences_path = self.root / "preferences.json"
+        self.window = WorkbenchWindow(
+            preferences_path=self.preferences_path,
+            checkpoint_directory=self.root / "checkpoints",
+        )
+
+    def tearDown(self) -> None:
+        self.window.close()
+        self.application.processEvents()
+        self.temporary.cleanup()
+
+    def test_menu_uses_dedicated_store_and_tracks_validity_without_changing_legacy(self) -> None:
+        self.assertEqual(self.window.format_menu.title(), "格式")
+        self.assertEqual(self.window.data_conversion_menu.title(), "数据转换")
+        self.assertEqual(self.window.pyfnirs_conversion_action.text(), "PYfNIRs")
+        self.assertEqual(
+            self.window.plugin_settings_store.path,
+            self.preferences_path.with_name("plugins.json"),
+        )
+        dedicated_path = self.preferences_path.with_name("pyfnirs_plugins.json")
+        self.assertEqual(self.window.pyfnirs_plugin_settings_store.path, dedicated_path)
+        self.assertFalse(self.window.data_conversion_action.isEnabled())
+        self.assertFalse(self.window.pyfnirs_conversion_action.isEnabled())
+        self.assertIn("插件 → 设置", self.window.data_conversion_action.toolTip())
+        self.assertIn("PYfNIRs 设置", self.window.pyfnirs_conversion_action.toolTip())
+
+        legacy_dir = self.root / "legacy-hypereeg"
+        _write_plugin(legacy_dir, include_source=False)
+        self.window.plugin_settings_store.save(PluginSettings(str(legacy_dir)))
+        self.window.refresh_plugins()
+        self.assertTrue(self.window.data_conversion_action.isEnabled())
+        self.assertFalse(self.window.pyfnirs_conversion_action.isEnabled())
+
+        wrong_source_dir = self.root / "wrong-source"
+        _write_plugin(wrong_source_dir, source_project="HyperEEG")
+        self.window.pyfnirs_plugin_settings_store.save(
+            PluginSettings(str(wrong_source_dir), None)
+        )
+        with patch.object(
+            self.window.plugin_settings_store,
+            "load",
+            side_effect=AssertionError("PYfNIRs menu must not read generic plugin settings"),
+        ):
+            self.window.format_menu.aboutToShow.emit()
+        self.assertTrue(self.window.data_conversion_action.isEnabled())
+        self.assertFalse(self.window.pyfnirs_conversion_action.isEnabled())
+
+        valid_dir = self.root / "pyfnirs-release"
+        valid_entry = _write_plugin(valid_dir, source_project="PYfNIRs")
+        self.window.pyfnirs_plugin_settings_store.save(
+            PluginSettings(str(valid_dir), None)
+        )
+        self.window.format_menu.aboutToShow.emit()
+        self.assertTrue(self.window.data_conversion_action.isEnabled())
+        self.assertTrue(self.window.pyfnirs_conversion_action.isEnabled())
+
+        persisted = PluginSettingsStore(dedicated_path).load()
+        self.assertEqual(persisted.directory, str(valid_dir.resolve()))
+        self.assertIsNone(persisted.python_executable)
+        stored = json.loads(dedicated_path.read_text(encoding="utf-8"))
+        self.assertEqual(
+            set(stored), {"schema_version", "directory", "python_executable"}
+        )
+        self.assertEqual(valid_entry, valid_dir / "PYfNIRs-DataConversion.exe")
+
+        valid_entry.unlink()
+        self.window.format_menu.aboutToShow.emit()
+        self.assertTrue(self.window.data_conversion_action.isEnabled())
+        self.assertFalse(self.window.pyfnirs_conversion_action.isEnabled())
+
+    def test_settings_are_separate_chinese_pages(self) -> None:
+        generic_dialog = PluginSettingsDialog(self.window.plugin_settings_store, self.window)
+        pyfnirs_dialog = PyfNIRsPluginSettingsDialog(
+            self.window.pyfnirs_plugin_settings_store, self.window
+        )
+        try:
+            self.assertEqual(generic_dialog.windowTitle(), "插件设置")
+            self.assertEqual(pyfnirs_dialog.windowTitle(), "PYfNIRs 转换器设置")
+            self.assertIn("通用数据转换配置", pyfnirs_dialog.explanation_label.text())
+            self.assertIs(generic_dialog.store, self.window.plugin_settings_store)
+            self.assertIs(pyfnirs_dialog.store, self.window.pyfnirs_plugin_settings_store)
+        finally:
+            generic_dialog.close()
+            pyfnirs_dialog.close()
+
+
+if __name__ == "__main__":
+    unittest.main()
